@page
@model Ogur.Sentinel.Api.Pages.Baerim.TrapLife.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Trap Life";
    var en = Model.Lang == "en";
}
<!DOCTYPE html>
<html lang="@Model.Lang" data-bs-theme="dark">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Trap Life</title>
    <link rel="icon" type="image/png" href="/files/baerim-og.png"/>
    <meta property="og:site_name" content="Ogur.dev"/>
    <meta property="og:type" content="website"/>
    <meta property="og:title" content="@(en ? "Baerim — The Trap Life Guide" : "Baerim — Poradnik Trap Life")"/>
    <meta property="og:description" content="@(en ? "How to become the king of chaos without having absolutely any plan." : "Jak zostać królem chaosu, nie mając absolutnie żadnego planu.")"/>
    <meta property="og:image" content="https://respy.ogur.dev/files/baerim-og.png"/>
    <meta property="og:url" content="https://respy.ogur.dev/baerim/traplife/"/>
    <meta name="theme-color" content="#43b581"/>
    <style>
        html { scroll-behavior: smooth; }
        html, body {
            margin: 0;
            padding: 0;
            background: #0d0d0f;
            color: #eee;
            font-family: system-ui, sans-serif;
        }

        .progress {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            width: 0;
            background: #43b581;
            z-index: 100;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            gap: 16px;
        }
        .topbar a { color: #aaa; text-decoration: none; font-size: 0.9rem; }
        .topbar a:hover { color: #fff; }
        .topbar-right { display: flex; align-items: center; gap: 16px; }
        .status { font-size: 0.9rem; color: #ddd; }
        .status a { margin-left: 12px; cursor: pointer; }
        .status-badge { font-size: 0.85rem; color: #666; }
        .login-link { color: #5865F2 !important; font-weight: 600; }
        .login-link:hover { color: #4752c4 !important; }

        .lang-switch { display: flex; gap: 4px; }
        .lang-switch a {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 6px;
            border: 1px solid #2a2a2e;
            color: #888;
        }
        .lang-switch a.active { color: #eee; border-color: #43b581; }

        .hero { text-align: center; padding: 30px 20px 10px; }
        .hero h1 { margin: 0 0 8px; font-size: 2.2rem; }
        .hero p { margin: 0; color: #999; font-style: italic; }

        .layout {
            display: grid;
            grid-template-columns: 320px minmax(0, 1fr);
            gap: 32px;
            max-width: 1040px;
            margin: 0 auto;
            padding: 30px 20px 160px;
        }

        .sidebar { position: sticky; top: 20px; align-self: start; }

        .player {
            background: #1a1a1e;
            border: 1px solid #2a2a2e;
            border-radius: 14px;
            padding: 14px;
            margin-bottom: 14px;
        }
        .player-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #999;
            margin-bottom: 10px;
        }
        .player input[type="range"] {
            width: 100%;
            margin: 0;
            accent-color: #43b581;
            cursor: pointer;
        }
        .player-time {
            display: flex;
            justify-content: space-between;
            font-size: 0.72rem;
            color: #888;
            margin: 4px 0 10px;
        }
        .player-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
        }
        .player-row + .player-row { margin-top: 10px; }
        .player button {
            background: #0d0d0f;
            color: #ddd;
            border: 1px solid #2a2a2e;
            border-radius: 8px;
            padding: 5px 9px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
        }
        .player button:hover { border-color: #43b581; color: #fff; }
        .player button.on { border-color: #43b581; color: #43b581; }
        .player button.primary { background: #43b581; color: #0d0d0f; border-color: #43b581; }
        .player button.primary:hover { filter: brightness(1.1); color: #0d0d0f; }
        .player .vol-range { flex: 1; min-width: 0; }

        .tools {
            background: #1a1a1e;
            border: 1px solid #2a2a2e;
            border-radius: 14px;
            padding: 14px;
            margin-bottom: 14px;
        }
        .tools input[type="search"] {
            width: 100%;
            box-sizing: border-box;
            background: #0d0d0f;
            border: 1px solid #2a2a2e;
            border-radius: 8px;
            color: #eee;
            padding: 8px 10px;
            font-size: 0.85rem;
            outline: none;
        }
        .tools input[type="search"]:focus { border-color: #43b581; }
        .tools label {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 10px;
            font-size: 0.82rem;
            color: #bbb;
            cursor: pointer;
        }

        .toc {
            list-style: none;
            margin: 0;
            padding: 0;
            background: #1a1a1e;
            border: 1px solid #2a2a2e;
            border-radius: 14px;
            overflow: hidden;
        }
        .toc a {
            display: block;
            padding: 9px 14px;
            font-size: 0.8rem;
            color: #999;
            text-decoration: none;
            border-left: 3px solid transparent;
        }
        .toc a:hover { color: #fff; }
        .toc a.active { color: #eee; border-left-color: #43b581; background: rgba(67, 181, 129, 0.08); }
        .toc li.hidden { display: none; }

        .rule {
            background: #1a1a1e;
            border: 1px solid #2a2a2e;
            border-radius: 14px;
            padding: 28px 30px;
            margin-bottom: 20px;
            scroll-margin-top: 20px;
            transition: opacity 0.2s ease, border-color 0.2s ease;
        }
        .rule.active { border-color: rgba(67, 181, 129, 0.6); }
        .rule.hidden { display: none; }
        body.focus .rule:not(.active) { opacity: 0.25; }
        .rule h2 { margin: 0 0 18px; font-size: 1.25rem; color: #43b581; }
        .rule p { margin: 0 0 14px; line-height: 1.65; color: #ddd; }
        .rule strong { color: #fff; }
        .rule ul { margin: 0 0 14px; padding-left: 22px; line-height: 1.8; color: #ddd; }
        .rule blockquote {
            margin: 0 0 14px;
            padding: 10px 16px;
            border-left: 3px solid #43b581;
            background: #14141a;
            border-radius: 0 8px 8px 0;
            color: #ccc;
            line-height: 1.6;
        }
        .rule blockquote p { margin: 0; }
        .rule .dialog p { margin: 0 0 8px; }
        .rule .dialog { margin-bottom: 14px; }

        .empty { display: none; text-align: center; color: #777; padding: 40px 0; }
        .empty.visible { display: block; }

        .hero-credits { margin-top: 10px; font-size: 0.85rem; color: #777; }
        .hero-credits a { color: #43b581; font-weight: 700; text-decoration: none; }
        .hero-credits a:hover { text-decoration: underline; }

        .reader-bar {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 50;
            display: flex;
            align-items: center;
            gap: 10px;
            background: #1a1a1e;
            border: 1px solid #2a2a2e;
            border-radius: 14px;
            padding: 8px 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            max-width: calc(100vw - 32px);
        }
        .reader-bar button {
            background: #43b581;
            color: #0d0d0f;
            font-weight: 700;
            border: none;
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 0.8rem;
            cursor: pointer;
        }
        .reader-bar button:disabled { opacity: 0.35; cursor: default; }
        .reader-bar button:not(:disabled):hover { filter: brightness(1.1); }
        .reader-label {
            font-size: 0.82rem;
            color: #ddd;
            min-width: 110px;
            text-align: center;
            white-space: nowrap;
        }

        .support-widget-box {
            position: fixed;
            bottom: 20px;
            left: 20px;
            width: 300px;
            z-index: 40;
            background: #1a1a1e;
            border: 1px solid #2a2a2e;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }
        .support-widget-collapsed-view {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 14px;
        }
        .support-widget-collapsed-view p {
            margin: 0;
            font-size: 0.8rem;
            color: #ccc;
            line-height: 1.3;
            flex: 1;
        }
        .support-widget-btn {
            background: #43b581;
            color: #0d0d0f;
            font-weight: 700;
            text-decoration: none;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.78rem;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .support-widget-btn:hover { filter: brightness(1.1); }
        .support-widget-toggle {
            background: none;
            border: none;
            color: #888;
            cursor: pointer;
            font-size: 0.9rem;
            padding: 2px 4px;
            flex-shrink: 0;
        }
        .support-widget-toggle:hover { color: #eee; }
        .support-widget-expanded-view { position: relative; }
        .support-widget-toggle-inline {
            position: absolute;
            top: 6px;
            right: 6px;
            z-index: 1;
            background: rgba(13,13,15,0.7);
            border-radius: 6px;
        }
        .support-widget-frame { width: 100%; height: 450px; border: 0; display: block; }
        .support-widget-box.collapsed .support-widget-expanded-view { display: none; }
        .support-widget-box:not(.collapsed) .support-widget-collapsed-view { display: none; }

        @@media (max-width: 860px) {
            .layout { grid-template-columns: minmax(0, 1fr); }
            .sidebar { position: static; }
            .toc { display: none; }
            .rule { padding: 20px; }
            .reader-bar { bottom: 84px; }
            .layout { padding-bottom: 220px; }
        }
    </style>
</head>
<body>
<div class="progress" id="progress"></div>

<div class="topbar">
    <a href="/baerim/">← Baerim</a>
    <div class="topbar-right">
        <div class="lang-switch">
            <a href="?lang=pl" class="@(en ? "" : "active")">PL</a>
            <a href="?lang=en" class="@(en ? "active" : "")">EN</a>
        </div>
    </div>
</div>

<div class="hero">
    <h1>@(en ? "💸 THE TRAP LIFE GUIDE" : "💸 PORADNIK TRAP LIFE")</h1>
    <p>@(en ? "How to become the king of chaos without having absolutely any plan" : "Jak zostać królem chaosu, nie mając absolutnie żadnego planu")</p>
    <div class="hero-credits">@(en ? "Guide by" : "Poradnik by") <a href="https://open.spotify.com/artist/2L8XxYhAW6SN5Txo8gpe1G" target="_blank" rel="noopener">Pery</a> &amp; <a href="https://ogur.dev" target="_blank" rel="noopener">ogur</a></div>
</div>

<div class="layout">
    <aside class="sidebar">
        <div class="player">
            <audio id="audio" src="/files/traplife.wav" preload="auto" loop></audio>
            <div class="player-title">@(en ? "Music" : "Muzyka")</div>
            <input type="range" id="seek" min="0" max="1000" value="0" step="1" aria-label="@(en ? "Seek" : "Przewijanie")"/>
            <div class="player-time"><span id="curTime">0:00</span><span id="durTime">0:00</span></div>
            <div class="player-row">
                <button type="button" id="restartBtn" title="@(en ? "From the start" : "Od początku")">|&lt;</button>
                <button type="button" id="backBtn" title="-10 s">-10s</button>
                <button type="button" id="playBtn" class="primary" title="@(en ? "Play / Pause" : "Odtwórz / Pauza")">▶️</button>
                <button type="button" id="fwdBtn" title="+10 s">+10s</button>
                <button type="button" id="loopBtn" class="on" title="@(en ? "Loop" : "Pętla")">@(en ? "Loop" : "Pętla")</button>
            </div>
            <div class="player-row">
                <button type="button" id="muteBtn">@(en ? "Mute" : "Wycisz")</button>
                <button type="button" id="volDownBtn" title="@(en ? "Volume down" : "Ciszej")">-</button>
                <input type="range" id="volume" class="vol-range" min="0" max="100" value="50" step="1" aria-label="@(en ? "Volume" : "Głośność")"/>
                <button type="button" id="volUpBtn" title="@(en ? "Volume up" : "Głośniej")">+</button>
            </div>
        </div>

        <div class="tools">
            <input type="search" id="filter" placeholder="@(en ? "Filter text..." : "Szukaj w poradniku...")"/>
            <label><input type="checkbox" id="focusMode"/> @(en ? "Focus mode" : "Tryb skupienia")</label>
        </div>
        <ul class="toc" id="toc"></ul>
    </aside>

    <main id="guide">
        @if (en)
        {
            <section class="rule" id="intro" data-kind="intro" data-toc="Intro">
                <p>Welcome, young apprentice.</p>
                <p>If you opened this guide, it means you looked at your life and thought:</p>
                <p><strong>“Fuck, this is really missing some responsibility.”</strong></p>
                <p>And that's great.</p>
                <p>Trap life is not a lifestyle.<br/>Trap life is a state of mind in which <strong>your decisions are made faster than your conscience can say “what the fuck are you doing?”</strong></p>
            </section>

            <section class="rule" id="r1" data-kind="rule">
                <h2>RULE NO. 1: NEVER HAVE A PLAN</h2>
                <p>Plans are for people who have a future.</p>
                <p>You have <strong>Tuesday</strong>.</p>
                <p>You wake up in the morning and you don't ask:</p>
                <blockquote><p>“What will I be doing in five years?”</p></blockquote>
                <p>You ask:</p>
                <blockquote><p>“Fuck, where's my phone?”</p></blockquote>
                <p>If you find your phone — success.</p>
                <p>If you find your wallet too — <strong>best day ever.</strong></p>
            </section>

            <section class="rule" id="r2" data-kind="rule">
                <h2>RULE NO. 2: MARRIAGE? ONLY IF YOU LIKE EXTREME SPORTS</h2>
                <p>Real trap life requires complicating your life on a level a normal person can't even comprehend.</p>
                <p>So if you have a wife, you absolutely cannot behave normally.</p>
                <p>I'm not even talking about cheating.</p>
                <p><strong>You're supposed to live a double life, even though you can barely handle one.</strong></p>
                <p>Monday:</p>
                <p>— Honey, I'm going to take out the trash.</p>
                <p>Tuesday:</p>
                <p>— Honey, why do you have three phones?</p>
                <p>Wednesday:</p>
                <p>— That's not my Lamborghini.</p>
                <p>Thursday:</p>
                <p>— <strong>THIS ISN'T EVEN MY HOUSE.</strong></p>
                <p>That's what trap life is.</p>
            </section>

            <section class="rule" id="r3" data-kind="rule">
                <h2>RULE NO. 3: YOUR MONEY MUST LOOK MORE LOST THAN YOU</h2>
                <p>Having money isn't enough.</p>
                <p>You have to make everyone who looks at it think:</p>
                <p><strong>“This man should absolutely not have access to the banking system.”</strong></p>
                <p>You buy a watch for 40 grand.</p>
                <p>Not because it tells the time.</p>
                <p>But because a 700 PLN phone also tells the time, and <strong>that would be a normal decision.</strong></p>
                <p>Normal decisions are the enemy of trap life.</p>
            </section>

            <section class="rule" id="r4" data-kind="rule">
                <h2>RULE NO. 4: YOUR CAR MUST BE BIGGER THAN YOUR APARTMENT</h2>
                <p>If the car costs more than the apartment — good.</p>
                <p>If the car payment costs more than your monthly food — <strong>great.</strong></p>
                <p>If you keep your groceries in the trunk because your apartment has no fridge —<br/><strong>WELCOME TO TRAP LIFE.</strong></p>
                <p>Most importantly, the car must have:</p>
                <ul>
                    <li>rims bigger than your ambitions,</li>
                    <li>tinted windows,</li>
                    <li>bass that cracks the plaster,</li>
                    <li>and a check engine light glowing like a Christmas tree.</li>
                </ul>
            </section>

            <section class="rule" id="r5" data-kind="rule">
                <h2>RULE NO. 5: NEVER ANSWER “I DON'T KNOW”</h2>
                <p>Trap life doesn't know the words “I don't know.”</p>
                <p>To every question, you answer:</p>
                <p><strong>“Relax, I've got a guy.”</strong></p>
                <div class="dialog">
                    <p>— Do you have a doctor?</p>
                    <p>— I've got a guy.</p>
                </div>
                <div class="dialog">
                    <p>— Do you have a plumber?</p>
                    <p>— I've got a guy.</p>
                </div>
                <div class="dialog">
                    <p>— Can you fly a plane?</p>
                    <p>— <strong>I've got a guy.</strong></p>
                </div>
                <div class="dialog">
                    <p>— But do you even know this guy?</p>
                    <p>— No.</p>
                </div>
                <div class="dialog">
                    <p>— THEN WHY THE FUCK DO YOU SAY YOU HAVE ONE?</p>
                    <p>— <strong>Because I've got his number.</strong></p>
                </div>
            </section>

            <section class="rule" id="r6" data-kind="rule">
                <h2>RULE NO. 6: YOU NEED A MYSTERIOUS PHONE</h2>
                <p>Every trap must have at least two phones.</p>
                <p>The first one:</p>
                <p>📱 a normal one.</p>
                <p>The second one:</p>
                <p>📱 black as your decisions.</p>
                <p>When someone asks:</p>
                <blockquote><p>“Why do you need a second phone?”</p></blockquote>
                <p>you answer:</p>
                <blockquote><p>“Work phone.”</p></blockquote>
                <p>Doesn't matter that you're unemployed.</p>
                <p><strong>It's a work phone.</strong></p>
                <p>It's used for very important business.</p>
                <p>What kind?</p>
                <p>Don't ask.</p>
            </section>

            <section class="rule" id="r7" data-kind="rule">
                <h2>RULE NO. 7: CONNECTIONS</h2>
                <p>You must know:</p>
                <ul>
                    <li>a DJ,</li>
                    <li>a club owner,</li>
                    <li>a mechanic,</li>
                    <li>a car guy,</li>
                    <li>a guy for “getting things done,”</li>
                    <li>a guy nobody knows,</li>
                    <li>and a guy who always says “relax, I'll handle it.”</li>
                </ul>
                <p>The last one is the most important.</p>
                <p>If something goes to shit, you call:</p>
                <p><strong>“Bro, remember me?”</strong></p>
                <p>— “No.”</p>
                <p><strong>“Exactly. Listen, I've got a problem.”</strong></p>
            </section>

            <section class="rule" id="r8" data-kind="rule">
                <h2>RULE NO. 8: THE PARTY CAN'T END NORMALLY</h2>
                <p>A normal person:</p>
                <blockquote><p>“Alright, it's two a.m., I'm going home.”</p></blockquote>
                <p>A trap:</p>
                <blockquote><p>“Alright, it's two a.m., let's drive to the other end of the country.”</p></blockquote>
                <p>Why?</p>
                <p>Nobody knows.</p>
                <p>At three:</p>
                <p><strong>“Fuck, why are we at a gas station?”</strong></p>
                <p>At four:</p>
                <p><strong>“Is this Czechia?”</strong></p>
                <p>At five:</p>
                <p><strong>“Has anyone seen Michał?”</strong></p>
                <p>At six:</p>
                <p><strong>“Which one of you has a driver's license?”</strong></p>
                <p>And then silence falls.</p>
            </section>

            <section class="rule" id="r9" data-kind="rule">
                <h2>RULE NO. 9: YOU ALWAYS NEED A STORY</h2>
                <p>You can't just say:</p>
                <blockquote><p>“I was at a party yesterday.”</p></blockquote>
                <p>That's for amateurs.</p>
                <p>You say:</p>
                <blockquote><p>“Dude, you won't believe what went down yesterday.”</p></blockquote>
                <p>And you take a fifteen-minute pause.</p>
                <p>Because a good story begins with the fact that <strong>nobody knows whether its narrator made it home alive.</strong></p>
            </section>

            <section class="rule" id="r10" data-kind="rule">
                <h2>RULE NO. 10: MOST IMPORTANT — CONFIDENCE</h2>
                <p>You might have no money.</p>
                <p>You might have no plan.</p>
                <p>You might have no driver's license.</p>
                <p>You might have no idea where you are.</p>
                <p>But you will walk into the room like a man who <strong>owns the building.</strong></p>
                <p>If someone says:</p>
                <blockquote><p>“Hey, you can't come in here.”</p></blockquote>
                <p>You look him in the eye.</p>
                <p>Adjust your jacket.</p>
                <p>And say:</p>
                <blockquote><p><strong>“I know.”</strong></p></blockquote>
                <p>And you leave.</p>
                <p>Because trap life isn't about having everything.</p>
                <p>Trap life is <strong>acting like you have everything, even when you have 17 PLN in your account and you're behind on rent.</strong></p>
            </section>

            <section class="rule" id="epilog" data-kind="epilog">
                <h2>EPILOGUE</h2>
                <p>Years from now, you'll understand the most important thing.</p>
                <p>Trap life isn't about money.</p>
                <p>It isn't about the car.</p>
                <p>It isn't about the parties.</p>
                <p>It isn't even about how many times you've said:</p>
                <p><strong>“Fuck, I'll handle it.”</strong></p>
                <p>Trap life is about the fact that <strong>you never handle it, but somehow you're still functioning in the morning.</strong></p>
                <p>So remember:</p>
                <p><strong>Don't ask if it's a good idea.</strong></p>
                <p><strong>Ask if it'll make a good story.</strong></p>
                <p>And if the answer is “yes”...</p>
                <p>you're probably just starting the biggest mistake of your life.</p>
                <p><strong>WELCOME TO TRAP LIFE.</strong></p>
            </section>
        }
        else
        {
            <section class="rule" id="intro" data-kind="intro" data-toc="Wstęp">
                <p>Witaj, młody adepcie.</p>
                <p>Jeżeli otworzyłeś ten poradnik, to znaczy, że spojrzałeś na swoje życie i pomyślałeś:</p>
                <p><strong>„Kurwa, brakuje mi tutaj jakiejś odpowiedzialności.”</strong></p>
                <p>I bardzo dobrze.</p>
                <p>Trap life to nie styl życia.<br/>Trap life to stan umysłu, w którym <strong>Twoje decyzje są podejmowane szybciej niż Twoje sumienie zdąży powiedzieć „co ty odpierdalasz?”</strong></p>
            </section>

            <section class="rule" id="r1" data-kind="rule">
                <h2>ZASADA NR 1: NIGDY NIE MIEJ PLANU</h2>
                <p>Plan jest dla ludzi, którzy mają przyszłość.</p>
                <p>Ty masz <strong>wtorek</strong>.</p>
                <p>Wstajesz rano i nie pytasz:</p>
                <blockquote><p>„Co będę robił za pięć lat?”</p></blockquote>
                <p>Pytasz:</p>
                <blockquote><p>„Kurwa, gdzie jest mój telefon?”</p></blockquote>
                <p>Jeżeli znajdziesz telefon — sukces.</p>
                <p>Jeżeli znajdziesz również portfel — <strong>dzień konia.</strong></p>
            </section>

            <section class="rule" id="r2" data-kind="rule">
                <h2>ZASADA NR 2: MAŁŻEŃSTWO? TYLKO JEŚLI LUBISZ SPORT EKSTREMALNY</h2>
                <p>Prawdziwy trap life wymaga komplikowania sobie życia na poziomie, którego normalny człowiek nawet nie rozumie.</p>
                <p>Dlatego jeżeli masz żonę, absolutnie nie możesz zachowywać się normalnie.</p>
                <p>Nie mówię nawet o zdradzaniu.</p>
                <p><strong>Ty masz prowadzić podwójne życie, mimo że jedno życie już ledwo ogarniasz.</strong></p>
                <p>Poniedziałek:</p>
                <p>— Kochanie, idę wyrzucić śmieci.</p>
                <p>Wtorek:</p>
                <p>— Kochanie, dlaczego masz trzy telefony?</p>
                <p>Środa:</p>
                <p>— To nie jest moje Lamborghini.</p>
                <p>Czwartek:</p>
                <p>— <strong>TO NIE JEST NAWET MÓJ DOM.</strong></p>
                <p>To właśnie jest trap life.</p>
            </section>

            <section class="rule" id="r3" data-kind="rule">
                <h2>ZASADA NR 3: PIENIĄDZE MUSZĄ WYGLĄDAĆ NA BARDZIEJ ZAGUBIONE NIŻ TY</h2>
                <p>Nie wystarczy mieć pieniądze.</p>
                <p>Musisz sprawić, żeby każdy, kto na nie patrzy, pomyślał:</p>
                <p><strong>„Ten człowiek absolutnie nie powinien mieć dostępu do systemu bankowego.”</strong></p>
                <p>Kupujesz zegarek za 40 tysięcy.</p>
                <p>Nie dlatego, że pokazuje godzinę.</p>
                <p>Tylko dlatego, że telefon za 700 zł też pokazuje godzinę, a <strong>to byłaby normalna decyzja.</strong></p>
                <p>Normalne decyzje są wrogiem trap life.</p>
            </section>

            <section class="rule" id="r4" data-kind="rule">
                <h2>ZASADA NR 4: SAMOCHÓD MUSI BYĆ WIĘKSZY OD TWOJEGO MIESZKANIA</h2>
                <p>Jeżeli samochód kosztuje więcej niż mieszkanie — dobrze.</p>
                <p>Jeżeli rata samochodu kosztuje więcej niż Twoje miesięczne jedzenie — <strong>świetnie.</strong></p>
                <p>Jeżeli w bagażniku trzymasz zakupy, bo w mieszkaniu nie masz lodówki —<br/><strong>WITAJ W TRAP LIFE.</strong></p>
                <p>Najważniejsze jest, żeby samochód miał:</p>
                <ul>
                    <li>felgi większe niż Twoje ambicje,</li>
                    <li>przyciemniane szyby,</li>
                    <li>bas, który powoduje pękanie tynku,</li>
                    <li>oraz kontrolkę silnika świecącą jak choinka.</li>
                </ul>
            </section>

            <section class="rule" id="r5" data-kind="rule">
                <h2>ZASADA NR 5: NIE ODPOWIADAJ „NIE WIEM”</h2>
                <p>Trap life nie zna słowa „nie wiem”.</p>
                <p>Na każde pytanie odpowiadasz:</p>
                <p><strong>„Spokojnie, mam człowieka.”</strong></p>
                <div class="dialog">
                    <p>— Masz lekarza?</p>
                    <p>— Mam człowieka.</p>
                </div>
                <div class="dialog">
                    <p>— Masz hydraulika?</p>
                    <p>— Mam człowieka.</p>
                </div>
                <div class="dialog">
                    <p>— Umiesz prowadzić samolot?</p>
                    <p>— <strong>Mam człowieka.</strong></p>
                </div>
                <div class="dialog">
                    <p>— Ale ty w ogóle znasz tego człowieka?</p>
                    <p>— Nie.</p>
                </div>
                <div class="dialog">
                    <p>— TO KURWA CZEMU MÓWISZ, ŻE MASZ?</p>
                    <p>— <strong>Bo mam numer.</strong></p>
                </div>
            </section>

            <section class="rule" id="r6" data-kind="rule">
                <h2>ZASADA NR 6: MUSISZ MIEĆ TAJEMNICZY TELEFON</h2>
                <p>Każdy trap musi posiadać minimum dwa telefony.</p>
                <p>Pierwszy:</p>
                <p>📱 normalny.</p>
                <p>Drugi:</p>
                <p>📱 czarny jak Twoje decyzje.</p>
                <p>Na pytanie:</p>
                <blockquote><p>„Po co ci drugi telefon?”</p></blockquote>
                <p>odpowiadasz:</p>
                <blockquote><p>„Służbowy.”</p></blockquote>
                <p>Nieważne, że jesteś bezrobotny.</p>
                <p><strong>To jest telefon służbowy.</strong></p>
                <p>Służy do bardzo ważnych służb.</p>
                <p>Jakich?</p>
                <p>Nie wnikaj.</p>
            </section>

            <section class="rule" id="r7" data-kind="rule">
                <h2>ZASADA NR 7: ZNAJOMOŚCI</h2>
                <p>Musisz znać:</p>
                <ul>
                    <li>DJ-a,</li>
                    <li>właściciela klubu,</li>
                    <li>mechanika,</li>
                    <li>typa od samochodów,</li>
                    <li>typa od „załatwiania rzeczy”,</li>
                    <li>typa, którego nikt nie zna,</li>
                    <li>oraz typa, który zawsze mówi „spokojnie, ja to ogarnę”.</li>
                </ul>
                <p>Najważniejszy jest ten ostatni.</p>
                <p>Jeżeli coś się spierdoli, dzwonisz:</p>
                <p><strong>„Stary, pamiętasz mnie?”</strong></p>
                <p>— „Nie.”</p>
                <p><strong>„No właśnie. Słuchaj, mam problem.”</strong></p>
            </section>

            <section class="rule" id="r8" data-kind="rule">
                <h2>ZASADA NR 8: IMPREZA NIE MOŻE SIĘ SKOŃCZYĆ NORMALNIE</h2>
                <p>Normalny człowiek:</p>
                <blockquote><p>„Dobra, jest druga w nocy, wracam do domu.”</p></blockquote>
                <p>Trap:</p>
                <blockquote><p>„Dobra, jest druga w nocy, jedziemy na drugi koniec kraju.”</p></blockquote>
                <p>Dlaczego?</p>
                <p>Nikt nie wie.</p>
                <p>O trzeciej:</p>
                <p><strong>„Kurwa, czemu jesteśmy na stacji benzynowej?”</strong></p>
                <p>O czwartej:</p>
                <p><strong>„Czy to jest Czechy?”</strong></p>
                <p>O piątej:</p>
                <p><strong>„Czy ktoś widział Michała?”</strong></p>
                <p>O szóstej:</p>
                <p><strong>„Który z was ma prawo jazdy?”</strong></p>
                <p>I wtedy zapada cisza.</p>
            </section>

            <section class="rule" id="r9" data-kind="rule">
                <h2>ZASADA NR 9: ZAWSZE MUSISZ MIEĆ HISTORIĘ</h2>
                <p>Nie możesz po prostu powiedzieć:</p>
                <blockquote><p>„Byłem wczoraj na imprezie.”</p></blockquote>
                <p>To jest dla amatorów.</p>
                <p>Ty mówisz:</p>
                <blockquote><p>„Stary, nie uwierzysz, co się wczoraj odpierdoliło.”</p></blockquote>
                <p>I robisz piętnastominutową pauzę.</p>
                <p>Bo dobra historia zaczyna się od tego, że <strong>nikt nie wie, czy jej narrator wrócił do domu żywy.</strong></p>
            </section>

            <section class="rule" id="r10" data-kind="rule">
                <h2>ZASADA NR 10: NAJWAŻNIEJSZE — PEWNOŚĆ SIEBIE</h2>
                <p>Możesz nie mieć pieniędzy.</p>
                <p>Możesz nie mieć planu.</p>
                <p>Możesz nie mieć prawa jazdy.</p>
                <p>Możesz nie mieć pojęcia, gdzie jesteś.</p>
                <p>Ale masz wejść do pomieszczenia jak człowiek, który <strong>jest właścicielem budynku.</strong></p>
                <p>Jeżeli ktoś mówi:</p>
                <blockquote><p>„Ej, ty tu nie możesz wejść.”</p></blockquote>
                <p>Patrzysz mu w oczy.</p>
                <p>Poprawiasz kurtkę.</p>
                <p>I mówisz:</p>
                <blockquote><p><strong>„Wiem.”</strong></p></blockquote>
                <p>I wychodzisz.</p>
                <p>Bo trap life to nie jest posiadanie wszystkiego.</p>
                <p>Trap life to <strong>zachowywanie się, jakbyś miał wszystko, nawet kiedy masz 17 zł na koncie i zalegasz z czynszem.</strong></p>
            </section>

            <section class="rule" id="epilog" data-kind="epilog">
                <h2>EPILOG</h2>
                <p>Po latach zrozumiesz najważniejszą rzecz.</p>
                <p>Trap life nie polega na pieniądzach.</p>
                <p>Nie polega na samochodzie.</p>
                <p>Nie polega na imprezach.</p>
                <p>Nie polega nawet na tym, ile razy powiedziałeś:</p>
                <p><strong>„Kurwa, ja to ogarnę.”</strong></p>
                <p>Trap life polega na tym, że <strong>nigdy nie ogarniasz, ale jakimś cudem rano nadal działasz.</strong></p>
                <p>Dlatego pamiętaj:</p>
                <p><strong>Nie pytaj, czy to dobry pomysł.</strong></p>
                <p><strong>Pytaj, czy będzie z tego dobra historia.</strong></p>
                <p>A jeżeli odpowiedź brzmi „tak”...</p>
                <p>to prawdopodobnie właśnie zaczynasz największy błąd swojego życia.</p>
                <p><strong>WITAJ W TRAP LIFE.</strong></p>
            </section>
        }

        <div class="empty" id="empty">@(en ? "No results." : "Brak wyników.")</div>
    </main>
</div>

<div class="reader-bar">
    <button type="button" id="prevBtn">←</button>
    <span class="reader-label" id="readerLabel"></span>
    <button type="button" id="nextBtn">→</button>
</div>

<div class="support-widget-box" id="supportWidgetTrap">
    <div class="support-widget-collapsed-view">
        <p>@(en ? "Enjoying the site? Support the server." : "Podoba Ci się strona? Wesprzyj serwer.")</p>
        <a class="support-widget-btn" href="https://zrzutka.pl/fhyeca" target="_blank" rel="noopener">@(en ? "Support" : "Wesprzyj")</a>
        <button class="support-widget-toggle" type="button" data-action="expand" aria-label="@(en ? "Expand" : "Rozwiń")">▸</button>
    </div>
    <div class="support-widget-expanded-view">
        <button class="support-widget-toggle support-widget-toggle-inline" type="button" data-action="collapse" aria-label="@(en ? "Collapse" : "Zwiń")">▾</button>
        <iframe class="support-widget-frame" src="https://zrzutka.pl/fhyeca/widget/13" frameborder="0" scrolling="no"></iframe>
    </div>
</div>

<script>
    (function () {
        const sections = [...document.querySelectorAll('.rule')];
        const rules = sections.filter(s => s.dataset.kind === 'rule');
        const toc = document.getElementById('toc');
        const label = document.getElementById('readerLabel');
        const progress = document.getElementById('progress');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const filter = document.getElementById('filter');
        const empty = document.getElementById('empty');
        const stepWord = @Json.Serialize(en ? "Rule" : "Zasada");
        let activeIndex = 0;

        const items = sections.map(s => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = '#' + s.id;
            a.textContent = s.dataset.toc || s.querySelector('h2').textContent;
            li.appendChild(a);
            toc.appendChild(li);
            return { li, a };
        });

        const visible = () => sections.filter(s => !s.classList.contains('hidden'));

        function setActive(index) {
            activeIndex = index;
            sections.forEach((s, i) => s.classList.toggle('active', i === index));
            items.forEach((it, i) => it.a.classList.toggle('active', i === index));
            const s = sections[index];
            label.textContent = s.dataset.kind === 'rule'
                ? `${stepWord} ${rules.indexOf(s) + 1} / ${rules.length}`
                : (s.dataset.toc || s.querySelector('h2').textContent);
            const v = visible();
            const pos = v.indexOf(s);
            prevBtn.disabled = pos <= 0;
            nextBtn.disabled = pos === -1 || pos >= v.length - 1;
        }

        const observer = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (e.isIntersecting) setActive(sections.indexOf(e.target));
            });
        }, { rootMargin: '-40% 0px -55% 0px' });
        sections.forEach(s => observer.observe(s));

        function go(delta) {
            const v = visible();
            const pos = v.indexOf(sections[activeIndex]);
            const target = v[Math.min(Math.max(pos + delta, 0), v.length - 1)];
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        prevBtn.addEventListener('click', () => go(-1));
        nextBtn.addEventListener('click', () => go(1));

        window.addEventListener('scroll', () => {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            progress.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
        }, { passive: true });

        document.getElementById('focusMode').addEventListener('change', e =>
            document.body.classList.toggle('focus', e.target.checked));

        filter.addEventListener('input', () => {
            const q = filter.value.trim().toLowerCase();
            let shown = 0;
            sections.forEach((s, i) => {
                const match = !q || s.textContent.toLowerCase().includes(q);
                s.classList.toggle('hidden', !match);
                items[i].li.classList.toggle('hidden', !match);
                if (match) shown++;
            });
            empty.classList.toggle('visible', shown === 0);
            setActive(activeIndex);
        });

        setActive(0);
    })();

    (function () {
        const audio = document.getElementById('audio');
        const seek = document.getElementById('seek');
        const volume = document.getElementById('volume');
        const curTime = document.getElementById('curTime');
        const durTime = document.getElementById('durTime');
        const playBtn = document.getElementById('playBtn');
        const muteBtn = document.getElementById('muteBtn');
        const loopBtn = document.getElementById('loopBtn');
        const words = @Json.Serialize(new
        {
        play = "▶️",
        pause = "⏸️",
        mute = en ? "Mute" : "Wycisz",
        unmute = en ? "Unmute" : "Włącz dźwięk"
        });
        const VOLUME_KEY = 'traplife_volume';
        let seeking = false;

        const fmt = s => {
            if (!isFinite(s)) return '0:00';
            const m = Math.floor(s / 60);
            const r = Math.floor(s % 60);
            return `${m}:${r < 10 ? '0' : ''}${r}`;
        };

        let initialVolume = 0.5;
        try {
            const saved = parseFloat(localStorage.getItem(VOLUME_KEY));
            if (!isNaN(saved)) initialVolume = Math.min(Math.max(saved, 0), 1);
        } catch (e) { }
        audio.volume = initialVolume;
        volume.value = Math.round(initialVolume * 100);

        function setVolume(v) {
            v = Math.min(Math.max(v, 0), 1);
            audio.volume = v;
            if (v > 0) audio.muted = false;
            try { localStorage.setItem(VOLUME_KEY, String(v)); } catch (e) { }
        }

        audio.addEventListener('loadedmetadata', () => { durTime.textContent = fmt(audio.duration); });
        audio.addEventListener('durationchange', () => { durTime.textContent = fmt(audio.duration); });
        audio.addEventListener('timeupdate', () => {
            if (seeking) return;
            curTime.textContent = fmt(audio.currentTime);
            seek.value = audio.duration ? Math.round((audio.currentTime / audio.duration) * 1000) : 0;
        });
        audio.addEventListener('play', () => { playBtn.textContent = words.pause; });
        audio.addEventListener('pause', () => { playBtn.textContent = words.play; });
        audio.addEventListener('volumechange', () => {
            volume.value = Math.round(audio.volume * 100);
            muteBtn.textContent = audio.muted ? words.unmute : words.mute;
            muteBtn.classList.toggle('on', audio.muted);
        });

        seek.addEventListener('input', () => {
            seeking = true;
            if (audio.duration) curTime.textContent = fmt((seek.value / 1000) * audio.duration);
        });
        seek.addEventListener('change', () => {
            if (audio.duration) audio.currentTime = (seek.value / 1000) * audio.duration;
            seeking = false;
        });

        playBtn.addEventListener('click', () => {
            if (audio.paused) audio.play().catch(() => { });
            else audio.pause();
        });
        document.getElementById('restartBtn').addEventListener('click', () => {
            audio.currentTime = 0;
            audio.play().catch(() => { });
        });
        document.getElementById('backBtn').addEventListener('click', () => {
            audio.currentTime = Math.max(0, audio.currentTime - 10);
        });
        document.getElementById('fwdBtn').addEventListener('click', () => {
            if (audio.duration) audio.currentTime = Math.min(audio.duration, audio.currentTime + 10);
        });
        loopBtn.addEventListener('click', () => {
            audio.loop = !audio.loop;
            loopBtn.classList.toggle('on', audio.loop);
        });
        muteBtn.addEventListener('click', () => { audio.muted = !audio.muted; });
        volume.addEventListener('input', () => setVolume(volume.value / 100));
        document.getElementById('volDownBtn').addEventListener('click', () => setVolume(audio.volume - 0.1));
        document.getElementById('volUpBtn').addEventListener('click', () => setVolume(audio.volume + 0.1));

        muteBtn.textContent = words.mute;
        playBtn.textContent = words.play;

        audio.play().catch(() => {
            const events = ['pointerdown', 'keydown', 'touchstart'];
            const start = () => {
                events.forEach(ev => document.removeEventListener(ev, start, true));
                if (audio.paused) audio.play().catch(() => { });
            };
            events.forEach(ev => document.addEventListener(ev, start, true));
        });
    })();

    (function () {
        const COLLAPSED_UNTIL_KEY = 'baerim_support_widget_collapsed_until';
        const USER_EXPANDED_KEY = 'baerim_support_widget_user_expanded';
        const HOURS = 24;

        function isCollapsed() {
            const until = parseInt(localStorage.getItem(COLLAPSED_UNTIL_KEY) || '0', 10);
            if (until > Date.now()) return true;
            return localStorage.getItem(USER_EXPANDED_KEY) !== '1';
        }

        function setCollapsed(collapsed) {
            if (collapsed) {
                localStorage.setItem(COLLAPSED_UNTIL_KEY, String(Date.now() + HOURS * 60 * 60 * 1000));
                localStorage.removeItem(USER_EXPANDED_KEY);
            } else {
                localStorage.removeItem(COLLAPSED_UNTIL_KEY);
                localStorage.setItem(USER_EXPANDED_KEY, '1');
            }
        }
        const box = document.getElementById('supportWidgetTrap');
        if (!box) return;
        if (isCollapsed()) box.classList.add('collapsed');
        box.querySelectorAll('[data-action="collapse"]').forEach(btn =>
            btn.addEventListener('click', () => { box.classList.add('collapsed'); setCollapsed(true); })
        );
        box.querySelectorAll('[data-action="expand"]').forEach(btn =>
            btn.addEventListener('click', () => { box.classList.remove('collapsed'); setCollapsed(false); })
        );
    })();
</script>
</body>
</html>