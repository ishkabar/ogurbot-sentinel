@page
@model Ogur.Sentinel.Api.Pages.Baerim.UpgradeModel
@{
Layout = null;
ViewData["Title"] = "Baerim ulepszanie";
var en = Model.Lang == "en";
}
<!DOCTYPE html>
<html lang="@Model.Lang" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Baerim ulepszanie</title>
    <link rel="icon" type="image/png" href="/files/baerim-og.png" />
    <meta property="og:site_name" content="Ogur.dev" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Baerim — Ulepszanie" />
    <meta property="og:description" content="Sprawdź szansę na ulepszenie przedmiotu na kolejny poziom." />
    <meta property="og:image" content="https://respy.ogur.dev/files/baerim-og.png" />
    <meta property="og:url" content="https://respy.ogur.dev/baerim/upgrade" />
    <meta name="theme-color" content="#43b581" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            position: relative;
            background: #0d0d0f;
            color: #eee;
            font-family: system-ui, sans-serif;
        }
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            gap: 16px;
        }
        .topbar a { color: #aaa; text-decoration: none; font-size: 0.9rem; }
        .topbar a:hover { color: #fff; }
        .topbar-right { display: flex; align-items: center; gap: 16px; }
        .page-logo {
            position: absolute;
            top: 64px;
            left: 20px;
            z-index: 5;
            background: #1a1a1e;
            border: 1px solid #2a2a2e;
            border-radius: 14px;
            padding: 0;
        }

        .page-logo-img { width: 260px; max-width: 90vw; height: auto; border-radius: 14px; display: block; }

        @@media (max-width: 640px) {
            .page-logo {
                position: static;
                display: flex;
                justify-content: center;
                margin: 12px auto 16px;
            }
            .page-logo-img { width: 160px !important; }
        }
        .status { font-size: 0.9rem; color: #ddd; }
        .status a { margin-left: 12px; cursor: pointer; }
        .status-badge { font-size: 0.85rem; color: #666; }
        .login-link { color: #5865F2; text-decoration: none; font-weight: 600; }
        .login-link:hover { color: #4752c4; }

        .support-widget-box {
            position: fixed;
            bottom: 20px;
            left: 20px;
            width: 300px;
            z-index: 40;
            background: #1a1a1e;
            border: 1px solid #2a2a2e;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }
        .support-widget-collapsed-view {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 14px;
        }
        .support-widget-collapsed-view p {
            margin: 0;
            font-size: 0.8rem;
            color: #ccc;
            line-height: 1.3;
            flex: 1;
        }
        .support-widget-btn {
            background: #43b581;
            color: #0d0d0f;
            font-weight: 700;
            text-decoration: none;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.78rem;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .support-widget-btn:hover { filter: brightness(1.1); }
        .support-widget-toggle {
            background: none;
            border: none;
            color: #888;
            cursor: pointer;
            font-size: 0.9rem;
            padding: 2px 4px;
            flex-shrink: 0;
        }
        .support-widget-toggle:hover { color: #eee; }
        .support-widget-expanded-view { position: relative; }
        .support-widget-toggle-inline {
            position: absolute;
            top: 6px;
            right: 6px;
            z-index: 1;
            background: rgba(13,13,15,0.7);
            border-radius: 6px;
        }
        .support-widget-frame { width: 100%; height: 450px; border: 0; display: block; }
        .support-widget-box.collapsed .support-widget-expanded-view { display: none; }
        .support-widget-box:not(.collapsed) .support-widget-collapsed-view { display: none; }

        .lang-switch { display: flex; gap: 4px; }
        .lang-switch a {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 6px;
            border: 1px solid #2a2a2e;
            color: #888;
        }
        .lang-switch a.active { color: #eee; border-color: #43b581; }

        .hero { text-align: center; padding: 30px 20px 10px; }
        .hero h1 { margin: 0 0 8px; font-size: 2rem; }
        .hero p { margin: 0; color: #999; }

        .content {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
        }

        .calc-box {
            max-width: 640px;
            margin: 0 auto 24px;
            background: #1a1a1e;
            border: 1px solid #2a2a2e;
            border-radius: 14px;
            padding: 20px;
        }
        .calc-box h2 { margin: 0 0 16px; font-size: 1.1rem; }
        .calc-row { margin-bottom: 14px; }
        .calc-row label { display: block; font-size: 0.8rem; color: #999; margin-bottom: 6px; }
        .calc-search-wrap { position: relative; }
        .calc-search-input, .calc-select {
            width: 100%;
            box-sizing: border-box;
            background: #14141a;
            border: 1px solid #2a2a2e;
            border-radius: 8px;
            padding: 10px 12px;
            color: #eee;
            font-size: 0.95rem;
        }
        .calc-select:disabled { opacity: 0.5; }
        .calc-search-results {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            margin-top: 4px;
            background: #14141a;
            border: 1px solid #2a2a2e;
            border-radius: 8px;
            max-height: 220px;
            overflow-y: auto;
            z-index: 20;
            display: none;
        }
        .calc-search-results.show { display: block; }
        .calc-search-item { padding: 8px 12px; cursor: pointer; font-size: 0.88rem; }
        .calc-search-item:hover { background: #26262b; }
        .calc-selected-item { font-size: 0.85rem; color: #43b581; margin-top: 8px; min-height: 1em; }
        .calc-checks { display: flex; flex-wrap: wrap; gap: 14px; }
        .calc-checks label { display: flex; align-items: center; gap: 6px; font-size: 0.88rem; color: #ccc; margin: 0; }
        .calc-result { display: flex; align-items: center; gap: 16px; margin-top: 16px; }
        .calc-result-box { flex: 1; text-align: center; padding: 14px; border-radius: 10px; background: #14141a; }
        .calc-result-box.highlight { border: 1px solid #43b581; }
        .calc-result-label { display: block; font-size: 0.75rem; color: #999; margin-bottom: 4px; }
        .calc-result-value { font-size: 1.5rem; font-weight: 700; display: block; }
        .calc-result-arrow { color: #666; font-size: 1.3rem; }

        .search-box {
            position: relative;
        }
        .filters {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        .filter-select {
            background: #1a1a1e;
            border: 1px solid #2a2a2e;
            border-radius: 10px;
            padding: 10px 12px;
            color: #eee;
            font-size: 0.9rem;
        }
        .filter-select:focus {
            outline: none;
            border-color: #43b581;
        }
        .search-input {
            flex: 1;
            min-width: 200px;
            box-sizing: border-box;
            background: #1a1a1e;
            border: 1px solid #2a2a2e;
            border-radius: 10px;
            padding: 14px 16px;
            color: #eee;
            font-size: 1rem;
        }
        .search-input:focus {
            outline: none;
            border-color: #43b581;
        }

        .table-wrap {
            margin-top: 20px;
            overflow-x: auto;
            border: 1px solid #2a2a2e;
            border-radius: 12px;
        }
        .upgrade-table {
            border-collapse: collapse;
            width: 100%;
            min-width: 840px;
        }
        .upgrade-table th, .upgrade-table td {
            padding: 10px 8px;
            text-align: center;
            border-bottom: 1px solid #222;
            font-size: 0.85rem;
        }
        .upgrade-table thead th {
            color: #888;
            font-weight: 600;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            background: #14141a;
            position: sticky;
            top: 0;
        }
        .upgrade-table td:nth-child(2), .upgrade-table th:nth-child(2) {
            text-align: left;
        }
        .upgrade-table tbody tr:hover { background: #1f1f24; }
        .upgrade-table tbody tr.row-hidden { display: none; }

        .item-photo-placeholder {
            width: 96px;
            height: 48px;
            border-radius: 8px;
            background: #26262b;
            border: 1px dashed #3a3a3e;
            margin: 0 auto;
        }

        .item-icon {
            width: 48px;
            height: 48px;
            object-fit: contain;
            display: block;
            margin: 0 auto;
        }

        .item-name { font-weight: 600; }
        .item-sub { font-size: 0.72rem; color: #777; margin-top: 2px; }

        .chance-high { color: #43b581; font-weight: 700; }
        .chance-mid { color: rgb(222,156,47); font-weight: 700; }
        .chance-low { color: #ed4245; font-weight: 700; }
    </style>
</head>
<body>
<div class="topbar">
    <a href="/baerim/">← Baerim</a>
    <div class="topbar-right">
        <div class="lang-switch">
            <a href="?lang=pl" class="@(en ? "" : "active")">PL</a>
            <a href="?lang=en" class="@(en ? "active" : "")">EN</a>
        </div>
        @if (Model.IsLoggedIn)
        {
        <div class="status">
            <span>👤 @Model.DiscordUsername</span>
            <a href="/auth/discord/logout">@(en ? "Log out" : "Wyloguj")</a>
        </div>
        }
        else
        {
        <div class="status">
            <span class="status-badge">@(en ? "Not logged in" : "Niezalogowany")</span>
            <a class="login-link" href="/auth/discord/login?returnTo=/baerim/upgrade">@(en ? "Log in with Discord" : "Zaloguj przez Discord")</a>
        </div>
        }
    </div>
</div>
<div class="page-logo">
    <img src="/files/baerim-og.png" alt="Baerim" class="page-logo-img" />
</div>

<div class="hero">
    <h1>@(en ? "Upgrading" : "Ulepszanie")</h1>
    <p>@(en ? "Search for an item to see its upgrade success chances" : "Wyszukaj przedmiot, aby zobaczyć szanse na ulepszenie")</p>
</div>

<div class="calc-box">
    <h2>@(en ? "Upgrade calculator" : "Kalkulator ulepszania")</h2>

    <div class="calc-row">
        <label>@(en ? "Item" : "Przedmiot")</label>
        <div class="calc-search-wrap">
            <input type="text" id="calcItemSearch" class="calc-search-input" placeholder="@(en ? "Search item..." : "Szukaj przedmiotu...")" autocomplete="off" />
            <div class="calc-search-results" id="calcSearchResults"></div>
        </div>
        <div class="calc-selected-item" id="calcSelectedItem"></div>
    </div>

    <div class="calc-row">
        <label>@(en ? "Upgrade" : "Ulepszenie")</label>
        <select id="calcLevelSelect" class="calc-select" disabled></select>
    </div>

    <div class="calc-row calc-checks">
        <label><input type="checkbox" id="calcSeal5" /> @(en ? "5% seal" : "Pieczęć 5%")</label>
        <label><input type="checkbox" id="calcSeal10" /> @(en ? "10% seal" : "Pieczęć 10%")</label>
        <label><input type="checkbox" id="calcEvent" /> @(en ? "Upgrade event (+5%)" : "Event ulepszania (+5%)")</label>
    </div>

    <div class="calc-row">
        <label>@(en ? "Guild bonus" : "Bonus gildii")</label>
        <select id="calcGuildBonus" class="calc-select">
            <option value="0">0%</option>
            <option value="1">+1%</option>
            <option value="2">+2%</option>
            <option value="3">+3%</option>
            <option value="4">+4%</option>
            <option value="5">+5%</option>
            <option value="6">+6%</option>
            <option value="7">+7%</option>
            <option value="8">+8%</option>
            <option value="9">+9%</option>
            <option value="10">+10%</option>
            <option value="11">+11%</option>
            <option value="12">+12%</option>
            <option value="13">+13%</option>
            <option value="14">+14%</option>
            <option value="15">+15%</option>
        </select>
    </div>

    <div class="calc-result" id="calcResult" style="display:none;">
        <div class="calc-result-box">
            <span class="calc-result-label">@(en ? "Default chance" : "Domyślna szansa")</span>
            <span class="calc-result-value" id="calcDefaultPct">—</span>
        </div>
        <div class="calc-result-arrow">→</div>
        <div class="calc-result-box highlight">
            <span class="calc-result-label">@(en ? "With bonuses" : "Z bonusami")</span>
            <span class="calc-result-value" id="calcFinalPct">—</span>
        </div>
    </div>
</div>
<div class="support-widget-box" id="supportWidgetUpgrade">
    <div class="support-widget-collapsed-view">
        <p>@(en ? "Enjoying the site? Support the server." : "Podoba Ci się strona? Wesprzyj serwer.")</p>
        <a class="support-widget-btn" href="https://zrzutka.pl/fhyeca" target="_blank" rel="noopener">@(en ? "Support" : "Wesprzyj")</a>
        <button class="support-widget-toggle" type="button" data-action="expand" aria-label="@(en ? "Expand" : "Rozwiń")">▸</button>
    </div>
    <div class="support-widget-expanded-view">
        <button class="support-widget-toggle support-widget-toggle-inline" type="button" data-action="collapse" aria-label="@(en ? "Collapse" : "Zwiń")">▾</button>
        <iframe class="support-widget-frame" src="https://zrzutka.pl/fhyeca/widget/23" frameborder="0" scrolling="no"></iframe>
    </div>
</div>

<script>
    (function() {
        const COLLAPSED_UNTIL_KEY = 'baerim_support_widget_collapsed_until';
        const USER_EXPANDED_KEY = 'baerim_support_widget_user_expanded';
        const HOURS = 24;
        const isMobile = () => window.matchMedia('(max-width: 640px)').matches;

        function isCollapsed() {
            const until = parseInt(localStorage.getItem(COLLAPSED_UNTIL_KEY) || '0', 10);
            if (until > Date.now()) return true;
            if (localStorage.getItem(USER_EXPANDED_KEY) === '1') return false;
            return isMobile();
        }
        function setCollapsed(collapsed) {
            if (collapsed) {
                localStorage.setItem(COLLAPSED_UNTIL_KEY, String(Date.now() + HOURS * 60 * 60 * 1000));
                localStorage.removeItem(USER_EXPANDED_KEY);
            } else {
                localStorage.removeItem(COLLAPSED_UNTIL_KEY);
                localStorage.setItem(USER_EXPANDED_KEY, '1');
            }
        }
        const box = document.getElementById('supportWidgetUpgrade');
        if (!box) return;
        if (isCollapsed()) box.classList.add('collapsed');
        box.querySelectorAll('[data-action="collapse"]').forEach(btn =>
            btn.addEventListener('click', () => { box.classList.add('collapsed'); setCollapsed(true); })
        );
        box.querySelectorAll('[data-action="expand"]').forEach(btn =>
            btn.addEventListener('click', () => { box.classList.remove('collapsed'); setCollapsed(false); })
        );
    })();
</script>
<div class="content">
    <div class="filters">
        <input type="text" id="searchInput" class="search-input" placeholder="@(en ? "Filter by item name..." : "Filtruj po nazwie przedmiotu...")" autocomplete="off" />
        <select id="typeFilter" class="filter-select">
            <option value="">@(en ? "All types" : "Wszystkie typy")</option>
            <option value="weapon">@(en ? "Weapon" : "Broń")</option>
            <option value="armor">@(en ? "Armor" : "Zbroja")</option>
            <option value="helmet">@(en ? "Helmet" : "Hełm")</option>
            <option value="shield">@(en ? "Shield" : "Tarcza")</option>
            <option value="boots">@(en ? "Boots" : "Buty")</option>
            <option value="jewelry">@(en ? "Jewelry" : "Biżuteria")</option>
            <option value="belt">@(en ? "Belt" : "Pas")</option>
        </select>
        <select id="levelFilter" class="filter-select">
            <option value="">@(en ? "All levels" : "Wszystkie poziomy")</option>
            <option value="0-59">@(en ? "Up to 59" : "Do 59")</option>
            <option value="60-79">60-79</option>
            <option value="80-99">80-99</option>
            <option value="100-999">100+</option>
        </select>
    </div>

    <div class="table-wrap">
        <table class="upgrade-table">
            <thead>
            <tr>
                <th></th>
                <th>@(en ? "Item" : "Przedmiot")</th>
                <th>+1</th>
                <th>+2</th>
                <th>+3</th>
                <th>+4</th>
                <th>+5</th>
                <th>+6</th>
                <th>+7</th>
                <th>+8</th>
                <th>+9</th>
            </tr>
            </thead>
            <tbody id="upgradeTableBody"></tbody>
        </table>
    </div>

</div>

<script>
    // Categories where all items share one row per group (weapon/armor sets).
    // Everything else (jewelry, boots, helmets, shields, belts) gets one row per item.
    const GROUPED_PREFIXES = ['Bronie', 'Zbroja'];
    const IS_EN = @Html.Raw(en ? "true" : "false");

    function isGroupedCategory(groupName) {
        return GROUPED_PREFIXES.some(prefix => groupName.startsWith(prefix));
    }

    function localizedGroupName(g) {
        return (IS_EN && g.name_en) ? g.name_en : g.name;
    }

    function localizedItemName(g, index) {
        if (IS_EN && g.items_en && g.items_en[index]) return g.items_en[index];
        return g.items[index];
    }

    function localizedItemList(g) {
        return g.items.map((_, i) => localizedItemName(g, i)).join(', ');
    }

    function chanceClass(value) {
        if (value >= 0.7) return 'chance-high';
        if (value >= 0.4) return 'chance-mid';
        return 'chance-low';
    }

    function iconUrl(id) {
        return `/files/items/${String(id).padStart(5, '0')}.png`;
    }

    function buildEntries(data) {
        return data.groups.flatMap(g => {
            if (isGroupedCategory(g.name)) {
                return [{
                    name: localizedGroupName(g),
                    sub: localizedItemList(g),
                    chances: g.chances,
                    icon: g.icons ? g.icons[0] : null,
                    type: g.type,
                    level: g.level,
                    searchText: (g.name + ' ' + (g.name_en || '') + ' ' + g.items.join(' ') + ' ' + (g.items_en || []).join(' ')).toLowerCase()
                }];
            }
            return g.items.map((_, i) => ({
                name: localizedItemName(g, i),
                sub: localizedGroupName(g),
                chances: g.chances,
                icon: g.icons ? g.icons[i] : null,
                type: g.type,
                level: g.level,
                searchText: (g.items[i] + ' ' + (g.items_en?.[i] || '') + ' ' + g.name).toLowerCase()
            }));
        });
    }

    // Always one row per item, regardless of grouping — used only for the calculator search
    function buildFlatItems(data) {
        return data.groups.flatMap(g =>
            g.items.map((_, i) => ({
                name: localizedItemName(g, i),
                sub: localizedGroupName(g),
                chances: g.chances,
                icon: g.icons ? g.icons[i] : null,
                type: g.type,
                level: g.level,
                searchText: (g.items[i] + ' ' + (g.items_en?.[i] || '') + ' ' + g.name).toLowerCase()
            }))
        );
    }

    function renderRows(entries) {
        const tbody = document.getElementById('upgradeTableBody');
        tbody.innerHTML = entries.map(entry => {
            const cells = entry.chances.map(v => {
                const pct = Math.round(v * 100);
                return `<td class="${chanceClass(v)}">${pct}%</td>`;
            }).join('');

            const iconCell = entry.icon
                ? `<img src="${iconUrl(entry.icon)}" class="item-icon" alt="" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'item-photo-placeholder'}))" />`
                : '<div class="item-photo-placeholder"></div>';

            return `<tr data-search="${entry.searchText}" data-type="${entry.type}" data-level="${entry.level}">
                <td>${iconCell}</td>
                <td>
                    <div class="item-name">${entry.name}</div>
                    <div class="item-sub">${entry.sub}</div>
                </td>
                ${cells}
            </tr>`;
        }).join('');
    }

    function levelInRange(level, rangeValue) {
        if (!rangeValue) return true;
        const [min, max] = rangeValue.split('-').map(Number);
        return level >= min && level <= max;
    }

    function applyFilters() {
        const q = document.getElementById('searchInput').value.trim().toLowerCase();
        const type = document.getElementById('typeFilter').value;
        const levelRange = document.getElementById('levelFilter').value;

        document.querySelectorAll('#upgradeTableBody tr').forEach(row => {
            const matchesSearch = !q || row.dataset.search.includes(q);
            const matchesType = !type || row.dataset.type === type;
            const matchesLevel = levelInRange(Number(row.dataset.level), levelRange);
            row.classList.toggle('row-hidden', !(matchesSearch && matchesType && matchesLevel));
        });
    }

    // --- Upgrade calculator ---
    let calcEntries = [];
    let calcSearchItems = [];
    let calcSelectedEntry = null;

    function initCalcLevelOptions() {
        const select = document.getElementById('calcLevelSelect');
        if (!select) return;
        select.innerHTML = Array.from({ length: 9 }, (_, i) =>
            `<option value="${i}">+${i} → +${i + 1}</option>`
        ).join('');
    }

    function renderCalcSearchResults(query) {
        const container = document.getElementById('calcSearchResults');
        if (!query) {
            container.classList.remove('show');
            container.innerHTML = '';
            return;
        }
        const q = query.toLowerCase();
        const matches = calcSearchItems.filter(e => e.searchText.includes(q)).slice(0, 12);

        if (matches.length === 0) {
            container.innerHTML = `<div class="calc-search-item" style="color:#666; cursor:default;">${IS_EN ? 'No matches' : 'Brak wyników'}</div>`;
        } else {
            container.innerHTML = matches.map((m) =>
                `<div class="calc-search-item" data-idx="${calcSearchItems.indexOf(m)}">${m.name}${m.sub ? ` — ${m.sub}` : ''}</div>`
            ).join('');
            container.querySelectorAll('.calc-search-item[data-idx]').forEach(el => {
                el.addEventListener('click', () => {
                    calcSelectedEntry = calcSearchItems[parseInt(el.dataset.idx, 10)];
                    document.getElementById('calcItemSearch').value = calcSelectedEntry.name;
                    document.getElementById('calcSelectedItem').textContent = IS_EN
                        ? `Selected: ${calcSelectedEntry.name}`
                        : `Wybrano: ${calcSelectedEntry.name}`;
                    document.getElementById('calcLevelSelect').disabled = false;
                    container.classList.remove('show');
                    computeCalc();
                });
            });
        }
        container.classList.add('show');
    }

    function computeCalc() {
        const resultBox = document.getElementById('calcResult');
        if (!calcSelectedEntry) {
            resultBox.style.display = 'none';
            return;
        }
        const levelIdx = parseInt(document.getElementById('calcLevelSelect').value, 10);
        const base = calcSelectedEntry.chances[levelIdx];

        const seal5 = document.getElementById('calcSeal5').checked ? 0.05 : 0;
        const seal10 = document.getElementById('calcSeal10').checked ? 0.10 : 0;
        const event = document.getElementById('calcEvent').checked ? 0.05 : 0;
        const guild = parseInt(document.getElementById('calcGuildBonus').value, 10) / 100;

        const final = Math.min(1, base + seal5 + seal10 + event + guild);

        document.getElementById('calcDefaultPct').textContent = `${Math.round(base * 100)}%`;
        document.getElementById('calcFinalPct').textContent = `${Math.round(final * 100)}%`;
        resultBox.style.display = 'flex';
    }

    function initCalculator() {
        const searchInput = document.getElementById('calcItemSearch');
        if (!searchInput) return;

        initCalcLevelOptions();

        searchInput.addEventListener('input', () => renderCalcSearchResults(searchInput.value.trim()));
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.calc-search-wrap')) {
                document.getElementById('calcSearchResults').classList.remove('show');
            }
        });

        document.getElementById('calcLevelSelect').addEventListener('change', computeCalc);
        document.getElementById('calcSeal5').addEventListener('change', computeCalc);
        document.getElementById('calcSeal10').addEventListener('change', computeCalc);
        document.getElementById('calcEvent').addEventListener('change', computeCalc);
        document.getElementById('calcGuildBonus').addEventListener('change', computeCalc);
    }

    async function init() {
        try {
            const resp = await fetch('/baerim/upgrade-data');
            const data = await resp.json();
            calcEntries = buildEntries(data);
            calcSearchItems = buildFlatItems(data);
            renderRows(calcEntries);
        } catch (e) {
            console.warn('Failed to load upgrade data', e);
        }

        document.getElementById('searchInput').addEventListener('input', applyFilters);
        document.getElementById('typeFilter').addEventListener('change', applyFilters);
        document.getElementById('levelFilter').addEventListener('change', applyFilters);

        initCalculator();
    }

    init();
</script>
</body>
</html>