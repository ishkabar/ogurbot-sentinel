@page
@model Ogur.Sentinel.Api.Pages.Baerim.Ore.ChunjoModel
@{
    Layout = null;
    ViewData["Title"] = "Baerim ruda Chunjo";
}
<!DOCTYPE html>
<html lang="pl" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Baerim ruda Chunjo</title>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            background: #0d0d0f;
            color: #eee;
            font-family: system-ui, sans-serif;
        }
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
        }
        .topbar a { color: #aaa; text-decoration: none; font-size: 0.9rem; }
        .topbar a:hover { color: #fff; }
        .status { font-size: 0.9rem; color: #ddd; }

        .login-block { text-align: center; margin-top: 80px; }
        .login-text { color: #ccc; font-size: 1.1rem; margin-bottom: 20px; }
        .login-btn {
            display: inline-block;
            background: #5865F2;
            color: #fff;
            text-decoration: none;
            font-size: 1.3rem;
            font-weight: 600;
            padding: 16px 40px;
            border-radius: 10px;
            transition: background 0.15s ease;
        }
        .login-btn:hover { background: #4752c4; color: #fff; }

        .map-wrap {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 80vh;
            padding: 0 20px;
        }

        .map-wrap { position: relative; }
        #mapPin {
            position: absolute;
            width: 14px;
            height: 14px;
            background: #ff3b3b;
            border: 2px solid #fff;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            display: none;
            box-shadow: 0 0 6px rgba(255,0,0,0.8);
            pointer-events: none;
        }
        #mapLabel {
            text-align: center;
            color: #ccc;
            margin-top: 10px;
            font-size: 0.95rem;
        }

        #mapImg {
            height: 100%;
            width: auto;
            max-width: 100%;
            image-rendering: pixelated;
            cursor: crosshair;
            border: 1px solid #333;
        }
    </style>
</head>
<body>
<div class="topbar">
    <a href="https://respy.ogur.dev/">← respy.ogur.dev</a>
    @if (Model.IsLoggedIn)
    {
        <div class="status">
            <span>👤 @Model.DiscordUsername</span>
            <a href="/auth/discord/logout" style="margin-left: 12px;">Wyloguj</a>
        </div>
    }
</div>

@if (!Model.IsLoggedIn)
{
    <div class="login-block">
        <p class="login-text">Zaloguj się przez Discord, żeby oznaczyć lokalizację rudy.</p>
        <a href="/auth/discord/login?returnTo=/baerim/ore/chunjo" class="login-btn">
            Zaloguj przez Discord
        </a>
    </div>
}
else
{
    <div class="map-wrap">
        <img id="mapImg" src="/files/Joan.png" alt="Mapa Chunjo" />
        <div id="mapPin"></div>
    </div>
    <p id="mapLabel"></p>
}
<script>
    let mapMarked = false;

    async function loadOreState() {
        try {
            const resp = await fetch('/ore/state');
            const data = await resp.json();
            renderState(data);
        } catch (e) {
            console.warn('Failed to load ore state', e);
        }
    }

    function renderState(data) {
        const pin = document.getElementById('mapPin');
        const label = document.getElementById('mapLabel');
        const img = document.getElementById('mapImg');

        if (data.marked) {
            mapMarked = true;
            const rect = img.getBoundingClientRect();
            const scaleX = rect.width / 171;
            const scaleY = rect.height / 214;
            pin.style.left = (data.x * scaleX) + 'px';
            pin.style.top = (data.y * scaleY) + 'px';
            pin.style.display = 'block';
            label.textContent = `Oznaczone przez ${data.marked_by_username}`;
            img.style.cursor = 'default';
        } else {
            mapMarked = false;
            pin.style.display = 'none';
            label.textContent = 'Kliknij mapę, aby oznaczyć lokalizację rudy';
            img.style.cursor = 'crosshair';
        }
    }

    const mapImgEl = document.getElementById('mapImg');
    if (mapImgEl) {
        mapImgEl.addEventListener('click', async (e) => {
            if (mapMarked) return;

            const rect = e.target.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 171;
            const y = ((e.clientY - rect.top) / rect.height) * 214;

            try {
                const resp = await fetch('/ore/mark', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ x, y })
                });
                const data = await resp.json();

                if (resp.ok) {
                    loadOreState();
                } else {
                    alert(data.error || 'Nie udało się oznaczyć lokalizacji');
                    loadOreState();
                }
            } catch (err) {
                alert('Błąd sieci: ' + err.message);
            }
        });

        loadOreState();
        setInterval(loadOreState, 15000);
    }
</script>
</body>
</html>