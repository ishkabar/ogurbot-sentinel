@page
@model Ogur.Sentinel.Api.Pages.Baerim.Ore.ChunjoModel
@{
    Layout = null;
    ViewData["Title"] = "Baerim ruda Chunjo";
}
<!DOCTYPE html>
<html lang="pl" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Baerim ruda Chunjo</title>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            background: #0d0d0f;
            color: #eee;
            font-family: system-ui, sans-serif;
            overflow-x: hidden;
        }
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
        }
        .topbar a { color: #aaa; text-decoration: none; font-size: 0.9rem; }
        .topbar a:hover { color: #fff; }
        .status { font-size: 0.9rem; color: #ddd; }
        .status a { margin-left: 12px; cursor: pointer; }

        .login-block { text-align: center; margin-top: 80px; }
        .login-text { color: #ccc; font-size: 1.1rem; margin-bottom: 20px; }
        .login-btn {
            display: inline-block;
            background: #5865F2;
            color: #fff;
            text-decoration: none;
            font-size: 1.3rem;
            font-weight: 600;
            padding: 16px 40px;
            border-radius: 10px;
            transition: background 0.15s ease;
        }
        .login-btn:hover { background: #4752c4; color: #fff; }

        .page-content {
            display: flex;
            height: calc(100vh - 60px);
        }

        .sidebar {
            width: 240px;
            flex-shrink: 0;
            padding: 20px;
            border-right: 1px solid #222;
            overflow-y: auto;
        }
        .sidebar h3 {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #888;
            margin: 0 0 6px;
        }
        .sidebar .value {
            font-size: 1rem;
            color: #eee;
            margin: 0 0 20px;
        }
        .sidebar .value.muted { color: #666; }
        .sidebar .countdown {
            font-size: 1.4rem;
            font-weight: 700;
            color: #43b581;
        }

        .zoom-controls {
            display: flex;
            gap: 8px;
            margin-top: 4px;
        }
        .zoom-btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #1a1a1e;
            color: #eee;
            font-size: 1.2rem;
            cursor: pointer;
        }
        .zoom-btn:hover { background: #26262b; }

        .map-area {
            flex: 1;
            overflow: auto;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 20px;
            min-width: 0;
        }
        .map-wrap {
            position: relative;
            flex-shrink: 0;
            margin: auto;
        }

        .drawer-toggle {
            position: fixed;
            top: 70px;
            right: 0;
            background: #1a1a1e;
            border: 1px solid #333;
            border-right: none;
            color: #eee;
            padding: 10px 8px;
            border-radius: 8px 0 0 8px;
            cursor: pointer;
            z-index: 80;
            font-size: 1.1rem;
        }
        .drawer-toggle:hover { background: #26262b; }

        .drawer {
            position: fixed;
            top: 60px;
            right: 0;
            width: min(320px, 90vw);
            height: calc(100% - 60px);
            background: #14141a;
            border-left: 1px solid #222;
            z-index: 70;
            transform: translateX(100%);
            transition: transform 0.2s ease;
            overflow-y: auto;
            padding: 20px;
            box-sizing: border-box;
        }
        .drawer.open {
            transform: translateX(0);
        }

        .drawer h3 {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #888;
            margin: 20px 0 10px;
        }
        .drawer h3:first-child { margin-top: 0; }

        .drawer-item {
            padding: 8px 0;
            border-bottom: 1px solid #222;
            font-size: 0.85rem;
            color: #ccc;
        }
        .drawer-item .time { color: #888; font-size: 0.75rem; }
        .drawer-empty { color: #555; font-size: 0.85rem; font-style: italic; }

        #mapImg {
            display: block;
            image-rendering: pixelated;
            cursor: crosshair;
        }

        #mapPin {
            position: absolute;
            width: 14px;
            height: 14px;
            background: #ff3b3b;
            border: 2px solid #fff;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            display: none;
            box-shadow: 0 0 6px rgba(255,0,0,0.8);
            pointer-events: none;
        }

        .modal-backdrop-ore {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            z-index: 100;
            align-items: center;
            justify-content: center;
        }
        .modal-backdrop-ore.show { display: flex; }
        .modal-box {
            background: #1a1a1e;
            border: 1px solid #333;
            border-radius: 12px;
            padding: 24px 28px;
            text-align: center;
            min-width: 280px;
        }
        .modal-box p { margin: 0 0 18px; color: #ddd; font-size: 1rem; }
        .modal-actions { display: flex; gap: 10px; justify-content: center; }
        .modal-btn {
            padding: 10px 22px;
            border-radius: 8px;
            border: none;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
        }
        .modal-btn.confirm { background: #43b581; color: #fff; }
        .modal-btn.confirm:hover { background: #379165; }
        .modal-btn.cancel { background: #444; color: #ddd; }
        .modal-btn.cancel:hover { background: #555; }

        .reset-btn {
            display: none;
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #ed4245;
            color: #fff;
            border: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            z-index: 50;
        }
        .reset-btn:hover { background: #c93639; }
    </style>
</head>
<body>
<div class="topbar">
    <a href="https://respy.ogur.dev/">← respy.ogur.dev</a>
    @if (Model.IsLoggedIn)
    {
        <div class="status">
            <span>👤 @Model.DiscordUsername</span>
            <a href="/auth/discord/logout">Wyloguj</a>
        </div>
    }
</div>

@if (!Model.IsLoggedIn)
{
    <div class="login-block">
        <p class="login-text">Zaloguj się przez Discord, żeby oznaczyć lokalizację rudy.</p>
        <a href="/auth/discord/login?returnTo=/baerim/ore/chunjo" class="login-btn">
            Zaloguj przez Discord
        </a>
    </div>
}
else
{
    <div class="page-content">
        <div class="sidebar">
            <h3>Sektor</h3>
            <p class="value muted" id="sidebarSector">—</p>

            <h3>Oznaczone przez</h3>
            <p class="value" id="sidebarMarkedBy">—</p>

            <h3>Ostatni resp</h3>
            <p class="value" id="sidebarLastRespawn">—</p>

            <h3>Następny resp za</h3>
            <p class="value countdown" id="sidebarCountdown">—:—</p>

            <h3>Zoom</h3>
            <div class="zoom-controls">
                <button class="zoom-btn" id="zoomOutBtn">−</button>
                <button class="zoom-btn" id="zoomInBtn">+</button>
            </div>
        </div>

        <div class="map-area">
            <div class="map-wrap">
                <img id="mapImg" src="/files/Joan.png" alt="Mapa Chunjo" />
                <div id="mapPin"></div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop-ore" id="confirmModal">
        <div class="modal-box">
            <p>Oznaczyć rudę w tym miejscu?</p>
            <div class="modal-actions">
                <button class="modal-btn confirm" id="confirmBtn">Oznacz tutaj</button>
                <button class="modal-btn cancel" id="cancelBtn">Anuluj</button>
            </div>
        </div>
    </div>

    <button class="drawer-toggle" id="drawerToggle">◀</button>
    <div class="drawer" id="drawer">
        <h3>Ostatnie oznaczenia</h3>
        <div id="marksListContainer"><p class="drawer-empty">Ładowanie...</p></div>

        <h3>Odwiedzający (6h)</h3>
        <div id="visitsListContainer"><p class="drawer-empty">Ładowanie...</p></div>
    </div>

    <button class="reset-btn" id="resetBtn">🗑️ Wyczyść oznaczenie</button>
}

<script>
    let pendingX = null;
    let pendingY = null;
    let lastOreData = null;
    let zoomLevel = 1;
    const ZOOM_MIN = 0.5;
    const ZOOM_MAX = 3;
    const ZOOM_STEP = 0.25;
    const BASE_HEIGHT_VH = 80;

    function applyZoom() {
        const img = document.getElementById('mapImg');
        if (!img) return;
        const baseHeight = window.innerHeight * (BASE_HEIGHT_VH / 100);
        img.style.height = (baseHeight * zoomLevel) + 'px';
        img.style.width = 'auto';
        if (lastOreData) renderState(lastOreData);
    }

    async function loadOreState() {
        try {
            const resp = await fetch('/ore/state');
            const data = await resp.json();
            lastOreData = data;
            renderState(data);
        } catch (e) {
            console.warn('Failed to load ore state', e);
        }
    }

    function renderState(data) {
        const pin = document.getElementById('mapPin');
        const img = document.getElementById('mapImg');
        if (!img) return;
        const wrap = img.closest('.map-wrap');

        if (data.marked) {
            const imgRect = img.getBoundingClientRect();
            const wrapRect = wrap.getBoundingClientRect();

            const scaleX = imgRect.width / 171;
            const scaleY = imgRect.height / 214;

            const offsetLeft = imgRect.left - wrapRect.left;
            const offsetTop = imgRect.top - wrapRect.top;

            pin.style.left = (offsetLeft + data.x * scaleX) + 'px';
            pin.style.top = (offsetTop + data.y * scaleY) + 'px';
            pin.style.display = 'block';

            document.getElementById('sidebarMarkedBy').textContent = data.marked_by_username;
            document.getElementById('sidebarSector').textContent = data.sector || '—';
        } else {
            pin.style.display = 'none';
            document.getElementById('sidebarMarkedBy').textContent = '—';
            document.getElementById('sidebarSector').textContent = '—';
        }

        if (data.window_start) {
            const start = new Date(data.window_start);
            const respawnTime = new Date(start.getTime() + 2 * 60 * 1000);
            document.getElementById('sidebarLastRespawn').textContent =
                respawnTime.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
        }

        if (data.window_end) {
            updateCountdown(new Date(data.window_end));
        }
    }

    let countdownTarget = null;
    let countdownInterval = null;

    function updateCountdown(targetDate) {
        countdownTarget = targetDate;
        if (countdownInterval) clearInterval(countdownInterval);
        tickCountdown();
        countdownInterval = setInterval(tickCountdown, 1000);
    }

    function tickCountdown() {
        if (!countdownTarget) return;
        const el = document.getElementById('sidebarCountdown');
        if (!el) return;
        const diffMs = countdownTarget.getTime() - Date.now();

        if (diffMs <= 0) {
            el.textContent = '00:00';
            loadOreState();
            return;
        }

        const totalSeconds = Math.floor(diffMs / 1000);
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        el.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    }

    function showConfirmModal(x, y) {
        pendingX = x;
        pendingY = y;
        document.getElementById('confirmModal').classList.add('show');
    }

    function hideConfirmModal() {
        pendingX = null;
        pendingY = null;
        document.getElementById('confirmModal').classList.remove('show');
    }

    async function submitMark(x, y) {
        try {
            const resp = await fetch('/ore/mark', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ x, y })
            });
            const data = await resp.json();

            if (resp.ok) {
                loadOreState();
            } else {
                alert(data.error || 'Nie udało się oznaczyć lokalizacji');
            }
        } catch (err) {
            alert('Błąd sieci: ' + err.message);
        }
    }

    async function checkOreAdmin() {
        try {
            const resp = await fetch('/ore/whoami');
            const data = await resp.json();
            const btn = document.getElementById('resetBtn');
            if (btn) btn.style.display = data.is_ore_admin ? 'block' : 'none';
        } catch (e) {
            console.warn('Failed to check ore admin status', e);
        }
    }

    const mapImgEl = document.getElementById('mapImg');
    if (mapImgEl) {
        mapImgEl.addEventListener('click', (e) => {
            const rect = e.target.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 171;
            const y = ((e.clientY - rect.top) / rect.height) * 214;
            showConfirmModal(x, y);
        });

        document.getElementById('confirmBtn').addEventListener('click', () => {
            if (pendingX !== null && pendingY !== null) {
                submitMark(pendingX, pendingY);
            }
            hideConfirmModal();
        });

        document.getElementById('cancelBtn').addEventListener('click', hideConfirmModal);

        document.getElementById('resetBtn').addEventListener('click', async () => {
            if (!confirm('Na pewno wyczyścić oznaczenie?')) return;
            try {
                const resp = await fetch('/ore/reset', { method: 'POST' });
                if (resp.ok) {
                    loadOreState();
                } else {
                    alert('Nie udało się zresetować (brak uprawnień?)');
                }
            } catch (e) {
                alert('Błąd sieci: ' + e.message);
            }
        });

        document.getElementById('zoomInBtn').addEventListener('click', () => {
            zoomLevel = Math.min(ZOOM_MAX, zoomLevel + ZOOM_STEP);
            applyZoom();
        });

        document.getElementById('zoomOutBtn').addEventListener('click', () => {
            zoomLevel = Math.max(ZOOM_MIN, zoomLevel - ZOOM_STEP);
            applyZoom();
        });

        document.getElementById('drawerToggle').addEventListener('click', () => {
            const drawer = document.getElementById('drawer');
            const btn = document.getElementById('drawerToggle');
            drawer.classList.toggle('open');
            btn.textContent = drawer.classList.contains('open') ? '▶' : '◀';
        });

        async function loadRecentMarks() {
            try {
                const resp = await fetch('/ore/marks/recent');
                const data = await resp.json();
                const container = document.getElementById('marksListContainer');

                if (!data.marks || data.marks.length === 0) {
                    container.innerHTML = '<p class="drawer-empty">Brak historii</p>';
                    return;
                }

                container.innerHTML = data.marks.map(m => {
                    const t = new Date(m.time);
                    const dateStr = t.toLocaleDateString('pl-PL');
                    const timeStr = t.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
                    return `<div class="drawer-item">
                <div>${m.username} — (${m.x.toFixed(1)}, ${m.y.toFixed(1)})</div>
                <div class="time">${dateStr} ${timeStr}</div>
            </div>`;
                }).join('');
            } catch (e) {
                console.warn('Failed to load recent marks', e);
            }
        }

        async function loadRecentVisits() {
            try {
                const resp = await fetch('/ore/visits/recent');
                const data = await resp.json();
                const container = document.getElementById('visitsListContainer');

                if (!data.visits || data.visits.length === 0) {
                    container.innerHTML = '<p class="drawer-empty">Brak odwiedzin</p>';
                    return;
                }

                container.innerHTML = data.visits.map(v => {
                    const t = new Date(v.time);
                    const timeStr = t.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
                    return `<div class="drawer-item">
                <div>${v.username}</div>
                <div class="time">${timeStr}</div>
            </div>`;
                }).join('');
            } catch (e) {
                console.warn('Failed to load recent visits', e);
            }
        }

        loadRecentMarks();
        loadRecentVisits();

        window.addEventListener('resize', applyZoom);

        applyZoom();
        loadOreState();
        checkOreAdmin();

        const stream = new EventSource('/ore/stream');
        stream.onmessage = (e) => {
            lastOreData = JSON.parse(e.data);
            renderState(lastOreData);
        };
        stream.onerror = () => {
            console.warn('SSE connection lost, reconnecting...');
        };
    }
</script>
</body>
</html>